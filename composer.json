{
    "name": "semitexa/notifications",
    "description": "Semitexa Notifications - one notification, many channels (mail, database inbox, your own), with per-recipient preferences",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": "*",
        "semitexa/orm": ">=2026.10.31.0849 || dev-master",
        "semitexa/mail": ">=2026.10.29.1052 || dev-master"
    },
    "require-dev": {
        "semitexa/testing": "*"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/orm": "2026.10.31.0849",
                "semitexa/mail": "2026.10.29.1052"
            }
        }
    },
    "keywords": [
        "semitexa",
        "notifications",
        "inbox",
        "mail",
        "preferences"
    ]
}
